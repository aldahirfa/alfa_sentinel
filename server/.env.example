DATABASE_URL=postgresql://usuario:password@localhost:5432/alfa_sentinel
# Obligatorio con HTTPS: el servidor no arranca con este valor de ejemplo
# ni con uno de menos de 32 caracteres. Genera uno propio con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=genera-uno-random-y-no-lo-compartas

# --- HTTPS (ver TLS_README.md) ---
# Se usan al arrancar con: python run_server.py
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
TLS_CERT_FILE=certs/server.crt
TLS_KEY_FILE=certs/server.key
